POSTGRES_DB=studioflow
POSTGRES_USER=studioflow
POSTGRES_PASSWORD=studioflow
DATABASE_URL=postgresql+asyncpg://studioflow:studioflow@db:5432/studioflow
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Legacy seed/bootstrap only; NEVER bypasses login.
DEV_AUTH_ENABLED=false
DEV_USER_ID=00000000-0000-0000-0000-000000000001


SESSION_HOURS=24
# Set true with HTTPS in production.
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_WORKSPACE_QUOTA_BYTES=104857600
INTEGRATION_LEAD_HOUR_LIMIT=100
# Outgoing webhooks stay disabled until the operator configures approved HTTPS URLs
# and a private random signing key (at least 32 characters). Never commit a real key.
WEBHOOK_DESTINATIONS={}
WEBHOOK_SIGNING_KEY=
