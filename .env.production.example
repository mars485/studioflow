DOMAIN=crm.example.com
# Generate a random hex password on the VPS; never commit the real file.
# Hex avoids special-character escaping in the PostgreSQL URL.
POSTGRES_PASSWORD=
APP_VERSION=local
# Only the address of an existing trusted reverse proxy; leave loopback for direct access.
TRUSTED_PROXY=127.0.0.1
# Enable when the VPS has working IPv6 (including outgoing HTTPS).
ENABLE_IPV6=false
